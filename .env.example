# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/image_gallery?sslmode=disable

# Storage Configuration (MinIO/S3/GCS)
# STORAGE_PROVIDER selects the backend: "s3" (default, MinIO/AWS via minio-go)
# or "gcs" (Google Cloud Storage via Application Default Credentials — no
# access/secret keys below apply to gcs).
STORAGE_PROVIDER=s3

# For local development (MinIO)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=images
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1

# For AWS S3 with static credentials
# STORAGE_ENDPOINT=s3.amazonaws.com
# STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# STORAGE_BUCKET=my-bucket-name
# STORAGE_USE_SSL=true
# STORAGE_REGION=us-west-2

# For AWS S3 with EKS Pod Identity / IAM Roles (leave credentials empty)
# STORAGE_ENDPOINT=s3.amazonaws.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=my-bucket-name
# STORAGE_USE_SSL=true
# STORAGE_REGION=us-west-2

# Cache Configuration (Valkey)
CACHE_ENABLED=true
CACHE_ADDRESS=localhost:6379
CACHE_PASSWORD=
CACHE_DATABASE=0
CACHE_DEFAULT_TTL=1h

# Optional Cache Performance Settings
# CACHE_MAX_RETRIES=3
# CACHE_POOL_SIZE=10
# CACHE_MIN_IDLE_CONNS=5
# CACHE_MAX_IDLE_CONNS=10
# CACHE_DIAL_TIMEOUT=5s
# CACHE_READ_TIMEOUT=3s
# CACHE_WRITE_TIMEOUT=3s

# Worker role (image-gallery worker) — also reads DATABASE_URL, STORAGE_* and
# CACHE_ADDRESS above; CACHE_ADDRESS is also the image-gallery:jobs queue.
WORKER_HEALTH_ADDR=:8081
WORKER_CONCURRENCY=2

# Demo controls (fault injection for the observability demo)
# true serves GET/PUT /api/settings/demo and POST /api/settings/demo/reset and
# injects the faults they configure; false removes those endpoints and builds
# no injector, in both the web and worker roles. There is no authentication,
# so this is an on/off switch, not access control.
DEMO_CONTROLS_ENABLED=true

# OpenTelemetry Configuration
# Service identification
# Leave OTEL_SERVICE_NAME unset: bootstrap.go only applies each role's own
# service.name (xplane-image-gallery / xplane-image-gallery-worker /
# image-gallery-loadgen) when this variable is empty. Setting it here
# overrides that for every role that loads this file, making web and worker
# indistinguishable in traces and logs.
# OTEL_SERVICE_NAME=image-gallery
# service.version defaults to the version built into the binary; setting it
# here overrides that.
# OTEL_SERVICE_VERSION=2.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development

# POD_NAME/POD_NAMESPACE become the k8s.pod.name/k8s.namespace.name resource
# attributes when set. In Kubernetes these come from the Downward API; leave
# them unset for local development.
# POD_NAME=
# POD_NAMESPACE=

# Traces (VictoriaTraces / OTLP endpoint)
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=localhost:4318

# For Kubernetes with VictoriaTraces:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=victoriametrics-victoria-logs-single-server:4318

# OTEL_TRACES_SAMPLER: always_on | always_off | traceidratio | parentbased_always_on |
# parentbased_always_off | parentbased_traceidratio (recommended for production, with
# OTEL_TRACES_SAMPLER_ARG as the ratio, e.g. 0.1 for 10%)
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Metrics (VictoriaMetrics Operator / OTLP endpoint)
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=localhost:4318

# For Kubernetes with VictoriaMetrics Operator:
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=vmagent:8429

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Valid log levels: debug, info, warn, error, fatal, panic
# Valid log formats: json, console