# GoReleaser Dockerfile for optimized production image
FROM gcr.io/distroless/static-debian12:nonroot

# Install ca-certificates and timezone data in distroless
# Note: These are already included in the distroless image

# Copy the binary (GoReleaser will handle this automatically)
COPY image-gallery /app/image-gallery

WORKDIR /app

# Expose port 8080
EXPOSE 8080

# Use non-root user (already configured in distroless:nonroot)
USER nonroot:nonroot

# Add healthcheck support (commented out as distroless doesn't include curl)
# HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
#     CMD curl -f http://localhost:8080/health || exit 1

# ENTRYPOINT + CMD: a Kubernetes `args` (the worker sidecar's ["worker"]) replaces CMD only.
ENTRYPOINT ["/app/image-gallery"]
CMD ["serve"]